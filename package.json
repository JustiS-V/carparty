{
  "name": "carparty",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @carparty/database build && turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter @carparty/database generate",
    "db:push": "pnpm --filter @carparty/database push",
    "db:studio": "pnpm --filter @carparty/database studio"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=20"
  }
}
