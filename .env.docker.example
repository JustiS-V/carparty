# Local run of the production containers with demo data:
#   cp .env.docker.example .env.docker
#   docker compose -f docker-compose.prod.yml --env-file .env.docker up -d --build
# CRM http://localhost:3000 · landing http://localhost:3001 · API http://localhost:4000/api
# If a port is taken, change it here and in CORS_ORIGIN / PUBLIC_* below.
CARPARTY_ENV_FILE=.env.docker
CRM_PORT=3000
LANDING_PORT=3001
API_PORT=4000

POSTGRES_USER=carparty
POSTGRES_PASSWORD=carparty
POSTGRES_DB=carparty

SEED_MODE=demo
JWT_SECRET=local-docker-secret-change-me
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
COLLECTOR_API_KEY=local-collector-key
PUBLIC_API_URL=http://localhost:4000/api
PUBLIC_PRODUCT_URL=http://localhost:3000
PUBLIC_BOT_URL=https://t.me/your_bot

# Listing sources and the bot start only when configured
TELEGRAM_BOT_TOKEN=
BOT_ADMIN_IDS=
BOT_API_URL=http://backend:4000/api
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_CHANNELS=
AUTORIA_API_KEY=
OLX_ENABLED=false
